---
import Layout from '../layouts/Layout.astro';
import AmanDokStudio from '../components/AmanDokStudio';
---

<Layout
  title="AmanDok - Studio Privasi Dokumen & Watermark KTP 100% Lokal"
  description="Lindungi KTP, KK, dan dokumen penting langsung di peramban (Zero-Upload). Beri watermark anti-pinjol, sensor NIK permanen, kompres target KB CPNS/BUMN, dan gabung ke PDF A4."
  studioMode={true}
>
  <h1 class="sr-only">AmanDok - Studio Privasi KTP dan Dokumen 100% Lokal (Zero-Upload)</h1>
  <main id="studio" class="flex-1 flex flex-col min-h-0 w-full">
    <AmanDokStudio client:load />
  </main>
</Layout>
