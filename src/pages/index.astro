---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AmanDokStudio from '../components/AmanDokStudio';
---

<Layout>
  <Navbar />

  <main class="mx-auto w-full max-w-7xl flex-1 px-4 pt-6 sm:px-6 sm:pt-8 lg:px-8">
    <!-- Clean, Compact Hero Section -->
    <section class="mb-6 text-center sm:mb-8">
      <div class="mx-auto mb-3 inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:border-emerald-500/30 dark:text-emerald-300">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span
          data-i18n-id="100% Diproses di Browser • Tanpa Upload Server • Aman Saat Offline"
          data-i18n-en="100% In-Browser Processing • Zero Server Upload • Works Offline"
        >
          100% Diproses di Browser • Tanpa Upload Server • Aman Saat Offline
        </span>
      </div>

      <h1
        class="mx-auto max-w-3xl text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl lg:text-4xl"
        data-i18n-id="Lindungi KTP & Siapkan Dokumen Lamaran Tanpa Risiko Kebocoran Data"
        data-i18n-en="Protect Your ID Card & Prepare Application Documents With Zero Leak Risk"
      >
        Lindungi KTP & Siapkan Dokumen Lamaran Tanpa Risiko Kebocoran Data
      </h1>

      <p
        class="mx-auto mt-2.5 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400 sm:text-base"
        data-i18n-id="Beri watermark anti-pinjol pada KTP, sensor NIK & tanda tangan, kompres pasfoto sesuai batas KB portal CPNS/BUMN, dan gabungkan ke PDF A4 langsung di perangkat Anda."
        data-i18n-en="Add anti-fraud watermarks to ID cards, redact ID numbers & signatures, compress photos to exact KB limits, and merge into A4 PDFs strictly on your device."
      >
        Beri watermark anti-pinjol pada KTP, sensor NIK & tanda tangan, kompres pasfoto sesuai batas KB portal CPNS/BUMN, dan gabungkan ke PDF A4 langsung di perangkat Anda.
      </p>
    </section>

    <!-- Interactive Studio Workspace -->
    <section id="studio" class="scroll-mt-20">
      <AmanDokStudio client:load />
    </section>

    <!-- Clean Privacy Guarantee Cards -->
    <section id="jaminan-privasi" class="mt-16 scroll-mt-20 sm:mt-20">
      <div class="mb-8 text-center">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
          PRIVASI TERVERIFIKASI
        </span>
        <h2
          class="mt-1.5 text-xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-2xl"
          data-i18n-id="Mengapa AmanDok Lebih Aman dari Kompresor atau Editor PDF Online Biasa?"
          data-i18n-en="Why Is AmanDok Safer Than Standard Online Image & PDF Editors?"
        >
          Mengapa AmanDok Lebih Aman dari Kompresor atau Editor PDF Online Biasa?
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        <!-- Card 1 -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-slate-700">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 font-mono text-sm font-bold text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400">
            01
          </div>
          <h3
            class="text-base font-bold text-slate-900 dark:text-white"
            data-i18n-id="Tanpa Upload Server (100% RAM Lokal)"
            data-i18n-en="Zero Server Upload (100% Local RAM)"
          >
            Tanpa Upload Server (100% RAM Lokal)
          </h3>
          <p
            class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400"
            data-i18n-id="Situs edit foto atau PDF biasa mengunggah KTP Anda ke server mereka. Di AmanDok, seluruh pemrosesan berjalan 100% di dalam browser Anda. Anda bahkan bisa mematikan Wi-Fi saat memproses dokumen."
            data-i18n-en="Typical online converters upload your ID card to remote servers. AmanDok processes everything locally inside your browser—you can even turn off Wi-Fi while editing."
          >
            Situs edit foto atau PDF biasa mengunggah KTP Anda ke server mereka. Di AmanDok, seluruh pemrosesan berjalan 100% di dalam browser Anda. Anda bahkan bisa mematikan Wi-Fi saat memproses dokumen.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-slate-700">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500/10 font-mono text-sm font-bold text-sky-600 dark:bg-sky-500/15 dark:text-sky-400">
            02
          </div>
          <h3
            class="text-base font-bold text-slate-900 dark:text-white"
            data-i18n-id="Hapus Otomatis Metadata EXIF & Lokasi GPS"
            data-i18n-en="Automatic EXIF & GPS Location Stripping"
          >
            Hapus Otomatis Metadata EXIF & Lokasi GPS
          </h3>
          <p
            class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400"
            data-i18n-id="Foto dokumen dari kamera HP menyimpan titik koordinat GPS rumah, tipe perangkat, dan waktu pengambilan. Saat dimuat ke AmanDok, seluruh metadata tersembunyi tersebut otomatis dibersihkan."
            data-i18n-en="Smartphone photos store exact home GPS coordinates and device info. When loaded into AmanDok, all hidden EXIF metadata is stripped automatically."
          >
            Foto dokumen dari kamera HP menyimpan titik koordinat GPS rumah, tipe perangkat, dan waktu pengambilan. Saat dimuat ke AmanDok, seluruh metadata tersembunyi tersebut otomatis dibersihkan.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900/70 dark:hover:border-slate-700">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-amber-500/10 font-mono text-sm font-bold text-amber-600 dark:bg-amber-500/15 dark:text-amber-400">
            03
          </div>
          <h3
            class="text-base font-bold text-slate-900 dark:text-white"
            data-i18n-id="Sensor Piksel Permanen (Anti Un-Blur)"
            data-i18n-en="Permanent Pixel Redaction"
          >
            Sensor Piksel Permanen (Anti Un-Blur)
          </h3>
          <p
            class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400"
            data-i18n-id="Menutupi NIK dengan kotak tempelan biasa sering kali masih menyisakan data asli di bawahnya. Fitur Sensor AmanDok meleburkan piksel gambar secara permanen sebelum berkas diunduh."
            data-i18n-en="Placing shapes over PDFs often leaves underlying text intact. AmanDok flattens and destroys underlying pixel data permanently before exporting."
          >
            Menutupi NIK dengan kotak tempelan biasa sering kali masih menyisakan data asli di bawahnya. Fitur Sensor AmanDok meleburkan piksel gambar secara permanen sebelum berkas diunduh.
          </p>
        </div>
      </div>
    </section>

    <!-- Clean Portal Specification Reference Table -->
    <section id="panduan" class="mt-16 scroll-mt-20 sm:mt-20">
      <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/70 sm:p-8">
        <div class="mb-6 flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
          <div>
            <span class="font-mono text-xs font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
              PANDUAN UKURAN BERKAS
            </span>
            <h2
              class="mt-1 text-xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-2xl"
              data-i18n-id="Acuan Spesifikasi Portal Rekrutmen & Layanan Publik"
              data-i18n-en="Standard Portal Document Size Specifications"
            >
              Acuan Spesifikasi Portal Rekrutmen & Layanan Publik
            </h2>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Rekomendasi pengaturan untuk Tab Target KB & Gabung PDF
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:text-slate-400">
                <th class="pb-3 pr-4">Keperluan / Portal</th>
                <th class="px-4 pb-3">Jenis Dokumen</th>
                <th class="px-4 pb-3">Rekomendasi Preset AmanDok</th>
                <th class="pb-3 pl-4">Batas Ukuran</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70 text-slate-600 dark:divide-slate-800/70 dark:text-slate-300">
              <tr class="transition hover:bg-slate-50/80 dark:hover:bg-slate-800/40">
                <td class="py-3.5 pr-4 font-bold text-slate-900 dark:text-white">
                  SSCASN (CPNS & PPPK)
                </td>
                <td class="px-4 py-3.5">Scan KTP & Pasfoto Latar Merah</td>
                <td class="px-4 py-3.5 font-medium text-emerald-600 dark:text-emerald-400">
                  Rasio KTP / 3×4 • Target ≤ 200 KB
                </td>
                <td class="py-3.5 pl-4">
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    100 – 200 KB (JPG)
                  </span>
                </td>
              </tr>
              <tr class="transition hover:bg-slate-50/80 dark:hover:bg-slate-800/40">
                <td class="py-3.5 pr-4 font-bold text-slate-900 dark:text-white">
                  Rekrutmen Bersama BUMN / HRD
                </td>
                <td class="px-4 py-3.5">KTP + NPWP + Ijazah Gabungan</td>
                <td class="px-4 py-3.5 font-medium text-emerald-600 dark:text-emerald-400">
                  Watermark HRD + PDF 2 Kartu/A4
                </td>
                <td class="py-3.5 pl-4">
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    ≤ 500 KB – 1 MB (PDF)
                  </span>
                </td>
              </tr>
              <tr class="transition hover:bg-slate-50/80 dark:hover:bg-slate-800/40">
                <td class="py-3.5 pr-4 font-bold text-slate-900 dark:text-white">
                  Verifikasi Bank / KPR / Leasing
                </td>
                <td class="px-4 py-3.5">KTP Pemohon, Pasangan & NPWP</td>
                <td class="px-4 py-3.5 font-medium text-emerald-600 dark:text-emerald-400">
                  Watermark Rapat "VERIFIKASI BANK"
                </td>
                <td class="py-3.5 pl-4">
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    ≤ 300 KB (JPG / PDF)
                  </span>
                </td>
              </tr>
              <tr class="transition hover:bg-slate-50/80 dark:hover:bg-slate-800/40">
                <td class="py-3.5 pr-4 font-bold text-slate-900 dark:text-white">
                  Sewa Properti / Kos / Kendaraan
                </td>
                <td class="px-4 py-3.5">Foto KTP & Bukti Identitas</td>
                <td class="px-4 py-3.5 font-medium text-emerald-600 dark:text-emerald-400">
                  Watermark Sewa + Sensor NIK & TTD
                </td>
                <td class="py-3.5 pl-4">
                  <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-[11px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    ≤ 200 KB (JPG)
                  </span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
