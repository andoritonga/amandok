---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 Halaman Tidak Ditemukan — AmanDok"
  description="Halaman yang Anda cari tidak ditemukan di AmanDok."
>
  <Navbar />

  <main class="mx-auto flex max-w-3xl flex-col items-center justify-center px-4 py-24 text-center">
    <div class="mb-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 font-mono text-xs font-bold text-emerald-400">
      ERROR 404 • SANDBOX ROUTE NOT FOUND
    </div>
    <h1 class="text-3xl font-extrabold text-white sm:text-4xl">
      Halaman Tidak Ditemukan
    </h1>
    <p class="mt-3 max-w-md text-sm text-slate-400">
      Rute yang Anda tuju tidak tersedia. Kembali ke studio utama untuk memberi watermark KTP, menyensor NIK, atau mengompres dokumen secara lokal.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-6 py-3 text-xs font-bold text-slate-950 transition hover:bg-emerald-400"
    >
      Kembali ke Studio AmanDok
    </a>
  </main>

  <Footer />
</Layout>
