---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404: Halaman Tidak Ditemukan - AmanDok"
  description="Halaman yang Anda tuju tidak tersedia di AmanDok."
  studioMode={false}
>
  <Navbar />

  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div
      class="max-w-md w-full rounded-xl p-6 sm:p-8 text-center studio-panel"
    >
      <p
        class="text-xs font-bold tracking-wider uppercase mb-2"
        style="color: var(--danger-text);"
      >
        HTTP 404
      </p>
      <h1
        class="text-xl sm:text-2xl font-bold mb-2"
        style="color: var(--text-primary);"
        data-i18n-id="Halaman Tidak Ditemukan"
        data-i18n-en="Page Not Found"
      >
        Halaman Tidak Ditemukan
      </h1>
      <p
        class="text-sm mb-6 leading-relaxed"
        style="color: var(--text-secondary);"
        data-i18n-id="Tautan atau berkas yang Anda cari tidak tersedia di jalur ini."
        data-i18n-en="The link or path you requested is not available on this server."
      >
        Tautan atau berkas yang Anda cari tidak tersedia di jalur ini.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center min-h-[44px] px-5 py-2.5 rounded-lg text-sm font-semibold transition-transform active:scale-[0.98]"
        style="background-color: var(--accent-solid); color: var(--accent-on-solid);"
        data-i18n-id="Kembali ke Studio AmanDok"
        data-i18n-en="Back to AmanDok Studio"
      >
        Kembali ke Studio AmanDok
      </a>
    </div>
  </main>

  <Footer />
</Layout>
