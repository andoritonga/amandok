---
---

<header class="sticky top-0 z-40 px-2.5 py-1.5 sm:mx-4 sm:mt-3 sm:px-4 sm:py-2 sm:rounded-2xl glass-bar">
  <div class="max-w-[1440px] mx-auto min-h-[44px] flex items-center justify-between gap-3">
    <a
      href="/"
      class="inline-flex items-center gap-2.5 min-h-[44px] py-1 rounded-xl group"
    >
      <span
        class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 glass-pill-active"
      >
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-sm font-bold tracking-tight" style="color: var(--text-primary);">
          AmanDok
        </span>
        <span
          class="text-xs"
          style="color: var(--text-muted);"
          data-i18n-id="Studio Privasi Lokal"
          data-i18n-en="Local Privacy Studio"
        >
          Studio Privasi Lokal
        </span>
      </span>
    </a>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="nav-lang-toggle"
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3 rounded-xl text-xs font-bold glass-pill active:scale-[0.97]"
        aria-label="Ubah bahasa ke English"
      >
        ID / EN
      </button>

      <button
        type="button"
        id="nav-theme-toggle"
        class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] rounded-xl glass-pill active:scale-[0.97]"
        aria-label="Ubah tema warna"
      >
        <svg
          id="nav-icon-sun"
          class="w-4 h-4 hidden dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg
          id="nav-icon-moon"
          class="w-4 h-4 block dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function getLang() {
      try {
        var saved = localStorage.getItem('amandok_lang');
        return saved === 'en' ? 'en' : 'id';
      } catch (e) {
        return 'id';
      }
    }

    function applyLang(lang) {
      document.documentElement.lang = lang;
      try {
        localStorage.setItem('amandok_lang', lang);
      } catch (e) {}

      var langBtn = document.getElementById('nav-lang-toggle');
      if (langBtn) {
        langBtn.textContent = lang.toUpperCase();
        langBtn.setAttribute(
          'aria-label',
          lang === 'id' ? 'Ubah bahasa ke English' : 'Switch language to Indonesian'
        );
      }

      var themeBtn = document.getElementById('nav-theme-toggle');
      if (themeBtn) {
        var isDark = document.documentElement.classList.contains('dark');
        themeBtn.setAttribute(
          'aria-label',
          lang === 'id'
            ? isDark
              ? 'Aktifkan mode terang'
              : 'Aktifkan mode gelap'
            : isDark
              ? 'Switch to light theme'
              : 'Switch to dark theme'
        );
      }

      document.querySelectorAll('[data-i18n-id]').forEach(function (el) {
        var next = lang === 'en' ? el.getAttribute('data-i18n-en') : el.getAttribute('data-i18n-id');
        if (next) el.textContent = next;
      });
    }

    function toggleTheme() {
      var isDark = document.documentElement.classList.contains('dark');
      var next = !isDark;
      if (next) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      var meta = document.getElementById('amandok-theme-color');
      if (meta) {
        meta.setAttribute('content', next ? '#060d17' : '#e6f0f2');
      }
      try {
        localStorage.setItem('amandok_theme', next ? 'dark' : 'light');
      } catch (e) {}
      applyLang(getLang());
    }

    var langBtn = document.getElementById('nav-lang-toggle');
    if (langBtn) {
      langBtn.addEventListener('click', function () {
        applyLang(getLang() === 'id' ? 'en' : 'id');
      });
    }

    var themeBtn = document.getElementById('nav-theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', toggleTheme);
    }

    applyLang(getLang());
  })();
</script>
