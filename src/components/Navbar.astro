---
---

<header class="sticky top-0 z-40 border-b-2 border-ink bg-sheet/95 backdrop-blur-md">
  <!-- Top Cryptographic Classification Ticker -->
  <div class="border-b border-ink/20 bg-ink px-4 py-1 text-sheet">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 font-mono text-[10px] tracking-wider">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 font-semibold text-[#6EE7B7]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#10B981]"></span>
          SANDBOX LOKAL AKTIF
        </span>
        <span class="hidden text-sheet/40 sm:inline">|</span>
        <span class="hidden text-sheet/80 sm:inline">STANDAR KARTU: ISO/IEC 7810 ID-1 (85.60 × 53.98 MM)</span>
      </div>
      <div class="flex items-center gap-3 text-sheet/80">
        <span>NETWORK EGRESS: <strong class="text-[#6EE7B7]">0.00 KB</strong></span>
        <span class="hidden text-sheet/40 md:inline">|</span>
        <span class="hidden md:inline">EXIF/GPS SCRUBBER: <strong class="text-[#FCD34D]">AUTO-PURGE</strong></span>
      </div>
    </div>
  </div>

  <!-- Main Architectural Header Bar -->
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand Identity Stamp -->
    <a
      href="/"
      class="group flex items-center gap-3.5 focus:outline-none"
      aria-label="AmanDok Beranda"
    >
      <div class="flex h-10 w-10 items-center justify-center border-2 border-ink bg-vermilion text-sheet shadow-press-sm transition-transform group-hover:-translate-y-0.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-display text-xl font-bold tracking-tight text-ink sm:text-2xl">
            AmanDok<span class="text-vermilion">.</span>
          </span>
          <span class="border border-ink bg-dossier px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-ink">
            SERI // ZERO-UPLOAD
          </span>
        </div>
        <p
          class="hidden font-mono text-[11px] text-slateink sm:block"
          data-i18n-id="Instrumen Kedaulatan Dokumen & Privasi KTP Warga"
          data-i18n-en="Citizen ID Privacy & Document Security Workbench"
        >
          Instrumen Kedaulatan Dokumen & Privasi KTP Warga
        </p>
      </div>
    </a>

    <!-- Navigation Links & Mechanical Language Switcher -->
    <div class="flex items-center gap-3 sm:gap-5">
      <nav class="hidden items-center gap-5 font-mono text-xs font-semibold uppercase tracking-wider text-ink md:flex">
        <a
          href="#studio"
          class="border-b-2 border-transparent py-1 transition hover:border-vermilion hover:text-vermilion"
          data-i18n-id="01. Meja Kerja"
          data-i18n-en="01. Lightdesk"
        >
          01. Meja Kerja
        </a>
        <a
          href="#jaminan-privasi"
          class="border-b-2 border-transparent py-1 transition hover:border-vermilion hover:text-vermilion"
          data-i18n-id="02. Protokol Privasi"
          data-i18n-en="02. Privacy Protocol"
        >
          02. Protokol Privasi
        </a>
        <a
          href="#panduan"
          class="border-b-2 border-transparent py-1 transition hover:border-vermilion hover:text-vermilion"
          data-i18n-id="03. Matriks Portal"
          data-i18n-en="03. Portal Matrix"
        >
          03. Matriks Portal
        </a>
      </nav>

      <!-- Mechanical Toggle (ID / EN) -->
      <div class="inline-flex border-2 border-ink bg-dossier p-0.5 shadow-press-sm">
        <button
          type="button"
          id="lang-btn-id"
          class="bg-ink px-2.5 py-1 font-mono text-xs font-bold text-sheet transition"
          aria-label="Bahasa Indonesia"
        >
          ID
        </button>
        <button
          type="button"
          id="lang-btn-en"
          class="px-2.5 py-1 font-mono text-xs font-bold text-ink transition hover:bg-ink/10"
          aria-label="English"
        >
          EN
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupLanguageSwitcher() {
    const btnId = document.getElementById('lang-btn-id');
    const btnEn = document.getElementById('lang-btn-en');

    const applyLang = (lang: 'id' | 'en') => {
      localStorage.setItem('amandok_lang', lang);
      window.dispatchEvent(new CustomEvent('amandok-lang-change', { detail: lang }));

      if (btnId && btnEn) {
        if (lang === 'id') {
          btnId.className = 'bg-ink px-2.5 py-1 font-mono text-xs font-bold text-sheet transition';
          btnEn.className = 'px-2.5 py-1 font-mono text-xs font-bold text-ink transition hover:bg-ink/10';
        } else {
          btnEn.className = 'bg-ink px-2.5 py-1 font-mono text-xs font-bold text-sheet transition';
          btnId.className = 'px-2.5 py-1 font-mono text-xs font-bold text-ink transition hover:bg-ink/10';
        }
      }

      document.querySelectorAll<HTMLElement>('[data-i18n-id]').forEach((el) => {
        const text = lang === 'id' ? el.getAttribute('data-i18n-id') : el.getAttribute('data-i18n-en');
        if (text) el.textContent = text;
      });
    };

    const saved = localStorage.getItem('amandok_lang');
    if (saved === 'en') {
      applyLang('en');
    }

    btnId?.addEventListener('click', () => applyLang('id'));
    btnEn?.addEventListener('click', () => applyLang('en'));
  }

  setupLanguageSwitcher();
</script>
