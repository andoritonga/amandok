---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200/80 bg-white text-slate-600 transition-colors dark:border-slate-800/80 dark:bg-slate-950 dark:text-slate-400">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
      <!-- Brand Summary -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <span class="text-base font-extrabold tracking-tight text-slate-900 dark:text-white">
            Aman<span class="text-emerald-600 dark:text-emerald-400">Dok</span>
          </span>
        </div>
        <p
          class="mt-3 max-w-sm text-xs leading-relaxed text-slate-500 dark:text-slate-400"
          data-i18n-id="Aplikasi web mandiri untuk memberi watermark KTP, menyensor NIK & tanda tangan, mengompres berkas lamaran sesuai batas KB, dan menggabungkan PDF 100% di dalam browser tanpa upload ke server."
          data-i18n-en="Self-contained web studio for ID card watermarking, permanent pixel redaction, target-KB compression, and A4 PDF merging strictly inside your browser."
        >
          Aplikasi web mandiri untuk memberi watermark KTP, menyensor NIK & tanda tangan, mengompres berkas lamaran sesuai batas KB, dan menggabungkan PDF 100% di dalam browser tanpa upload ke server.
        </p>
      </div>

      <!-- Capabilities -->
      <div class="md:col-span-4">
        <h3
          class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200"
          data-i18n-id="Fitur Utama"
          data-i18n-en="Core Capabilities"
        >
          Fitur Utama
        </h3>
        <ul class="mt-3 space-y-2 text-xs text-slate-500 dark:text-slate-400">
          <li>• Watermark KTP Anti-Pinjol (Rapat, Stempel & Pita)</li>
          <li>• Sensor Piksel Permanen NIK, Alamat & Tanda Tangan</li>
          <li>• Kompresor Target KB Presisi (100KB / 200KB / 300KB)</li>
          <li>• Gabung KTP, NPWP & Berkas ke Lembar PDF A4</li>
        </ul>
      </div>

      <!-- Developer & Links -->
      <div class="md:col-span-3">
        <h3
          class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200"
          data-i18n-id="Pengembang & Tautan"
          data-i18n-en="Developer & Links"
        >
          Pengembang & Tautan
        </h3>
        <ul class="mt-3 space-y-2 text-xs">
          <li>
            <a
              href="https://ritonga.ai.id"
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-600 dark:hover:text-emerald-400"
            >
              Ando (ritonga.ai.id) ↗
            </a>
          </li>
          <li>
            <a
              href="https://github.com/andoritonga/amandok"
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-600 dark:hover:text-emerald-400"
            >
              Kode Sumber (GitHub) ↗
            </a>
          </li>
          <li>
            <a
              href="https://gaji.ritonga.ai.id"
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-600 dark:hover:text-emerald-400"
            >
              HitungGaji.id (Kalkulator PPh 21) ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-slate-200/80 pt-6 text-xs text-slate-500 dark:border-slate-800/80 dark:text-slate-400 sm:flex-row">
      <p>
        © {year} AmanDok • Built by{' '}
        <a
          href="https://ritonga.ai.id"
          class="font-semibold text-slate-700 hover:text-emerald-600 dark:text-slate-200 dark:hover:text-emerald-400"
        >
          Ando
        </a>
      </p>
      <p class="font-mono text-[11px] text-emerald-600 dark:text-emerald-400">
        100% Client-Side • Zero Server Upload • Zero Cloud Storage
      </p>
    </div>
  </div>
</footer>
