---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  studioMode?: boolean;
}

const {
  title = 'AmanDok - Studio Privasi Dokumen & Watermark KTP 100% Lokal',
  description = 'Lindungi KTP, KK, dan Ijazah langsung di peramban (Zero-Upload). Beri watermark anti-pinjol, sensor NIK & tanda tangan permanen, kompres target KB CPNS/BUMN, dan gabungkan ke PDF.',
  studioMode = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dokumen.ritonga.ai.id');
const ogImageURL = new URL('/og-image.svg', 'https://dokumen.ritonga.ai.id');

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AmanDok',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any (Web Browser)',
  url: 'https://dokumen.ritonga.ai.id',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'IDR',
  },
  description:
    'Aplikasi web utilitas privasi dokumen 100% client-side untuk watermark KTP anti-pinjol, penyensoran data sensitif permanen, kompresor foto target KB, dan penggabung PDF A4.',
  author: {
    '@type': 'Person',
    name: 'Yohannes Christiando Ritonga',
    url: 'https://ritonga.ai.id',
  },
  inLanguage: ['id-ID', 'en-US'],
});
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta name="theme-color" content="#e6f0f2" id="amandok-theme-color" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="watermark ktp online aman, sensor nik ktp, kompres foto 100kb cpns, kompres foto bumn, gabung foto ke pdf tanpa upload, amandok, privasi dokumen"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />

    <script type="application/ld+json" set:html={schemaJson} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        function applyTheme(dark) {
          var root = document.documentElement;
          if (dark) {
            root.classList.add('dark');
          } else {
            root.classList.remove('dark');
          }
          var meta = document.getElementById('amandok-theme-color');
          if (meta) {
            meta.setAttribute('content', dark ? '#060d17' : '#e6f0f2');
          }
        }
        try {
          var savedTheme = localStorage.getItem('amandok_theme');
          var prefersDark =
            typeof window !== 'undefined' &&
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = savedTheme ? savedTheme === 'dark' : prefersDark;
          applyTheme(isDark);
        } catch (e) {
          applyTheme(false);
        }
        try {
          var savedLang = localStorage.getItem('amandok_lang');
          if (savedLang === 'en' || savedLang === 'id') {
            document.documentElement.lang = savedLang;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class={`min-h-dvh flex flex-col overflow-x-hidden antialiased liquid-stage ${
      studioMode ? 'lg:h-dvh lg:overflow-hidden' : ''
    }`}
  >
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.hostname !== 'localhost') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
