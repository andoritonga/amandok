---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'AmanDok — Meja Kerja Privasi KTP, Sensor NIK & Kompresor Dokumen 100% Lokal',
  description = 'Instrumen privasi dokumen warga Indonesia: beri segel watermark KTP anti-pinjol, sensor NIK & tanda tangan, kompres foto sesuai target KB (SSCASN/CPNS/BUMN), dan jilid PDF A4 100% di RAM browser tanpa upload server.',
  canonicalPath = '/',
} = Astro.props;

const siteUrl = 'https://dokumen.ritonga.ai.id';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = `${siteUrl}/og-image.svg`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'AmanDok',
  url: siteUrl,
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any (Web Browser)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'IDR',
  },
  description,
  author: {
    '@type': 'Person',
    name: 'Aliando Ritonga',
    url: 'https://ritonga.ai.id',
  },
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="watermark ktp, watermark ktp online aman, sensor nik ktp, kompres foto 200kb cpns, gabung ktp npwp jadi pdf, tanpa upload server, amandok"
    />
    <meta name="author" content="Aliando Ritonga" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#F3EFE6" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Fraunces (Display Serif), Plus Jakarta Sans (Body), IBM Plex Mono (Technical) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;0,9..144,800;1,9..144,600&family=IBM+Plex+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="bg-archival-paper min-h-screen text-ink antialiased">
    <a
      href="#studio"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:border-2 focus:border-ink focus:bg-vermilion focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:text-sheet focus:shadow-press"
    >
      [LANGSUNG KE MEJA INSPEKSI DOKUMEN]
    </a>
    <slot />
  </body>
</html>
